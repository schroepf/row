[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
tab_width = 4
ij_continuation_indent_size = 8
ij_formatter_off_tag = @formatter:off
ij_formatter_on_tag = @formatter:on
ij_formatter_tags_enabled = true
ij_smart_tabs = false
ij_visual_guides = 120
ij_wrap_on_typing = false

[*.kt]
max_line_length = 120
insert_final_newline = true

[*.json]
indent_size = 2
